# Copy to a root-owned runtime file such as /etc/ai-launchkit/n8n-queue-watchdog.env.
# Never commit the runtime file or a real API key/password.

# Required for execution. Both workflow IDs are required if notification
# correlation is enabled; a partial pair is unhealthy and never complete.
N8N_WATCHDOG_API_URL=
N8N_API_KEY=

# Restrict labels and reads to the workflows that require this alert path.
N8N_WATCHDOG_WORKFLOW_IDS=
N8N_WATCHDOG_MAX_WORKFLOW_LABELS=50
N8N_WATCHDOG_MAX_RESPONSE_BYTES=5000000
N8N_WATCHDOG_MAX_PAGES=10
N8N_WATCHDOG_SOURCE_LOOKBACK_SECONDS=3600
N8N_WATCHDOG_ERROR_WORKFLOW_ID=
N8N_WATCHDOG_SLACK_WORKFLOW_ID=

# Optional dependency probes. Leave blank to disable a probe rather than
# turning an unreachable local-only endpoint into a false alarm.
N8N_WATCHDOG_N8N_HEALTH_URL=
N8N_WATCHDOG_WORKER_HEALTH_URL=
N8N_WATCHDOG_REDIS_HOST=
N8N_WATCHDOG_REDIS_PORT=6379
N8N_WATCHDOG_REDIS_USERNAME=
N8N_WATCHDOG_REDIS_PASSWORD=
N8N_WATCHDOG_POSTGRES_HOST=
N8N_WATCHDOG_POSTGRES_PORT=5432

# Bounded collection controls.
N8N_WATCHDOG_NOTIFICATION_GRACE_SECONDS=60
N8N_WATCHDOG_FAILURE_RETENTION_SECONDS=3600
N8N_WATCHDOG_EXECUTION_LIMIT=100
N8N_WATCHDOG_REDIS_SCAN_COUNT=100
N8N_WATCHDOG_REDIS_MAX_KEYS=500
N8N_WATCHDOG_PROBE_TIMEOUT_SECONDS=2
N8N_WATCHDOG_SCRAPE_CACHE_SECONDS=10
