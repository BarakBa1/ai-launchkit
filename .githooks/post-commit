#!/usr/bin/env bash
# Regenerate this repo's repomix packed output after every commit.
# Install once per clone:
#   git config core.hooksPath .githooks
# See ../../docs/repomix.md (workspace root) for the rationale.

set -euo pipefail

OUT="repomix-ai-launchkit.xml"
REPO_ROOT="$(git rev-parse --show-toplevel)"

cd "$REPO_ROOT"

if ! command -v npx >/dev/null 2>&1; then
  echo "repomix: npx not on PATH; skipped $OUT regeneration" >&2
  exit 0
fi

npx --yes repomix --output "$OUT" --style xml >/dev/null
echo "repomix: regenerated $OUT"